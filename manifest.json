{
  "manifest_version": 3,
  "name": "LaPlateforme.io - Hub Étudiant",
  "version": "1.0.0",
  "version_name": "1.0 Release",
  "description": "Centralise tous les outils de LaPlateforme.io pour les étudiants",
  "author": "Pascal Fortunati",
  "homepage_url": "https://github.com/pascal-fortunati",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://intra.pro.laplateforme.io/*",
    "https://github.com/*",
    "https://*.students-laplateforme.io/*",
    "https://www.figma.com/*",
    "https://students-laplateforme.io:8443/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "short_name": "LP Hub",
  "offline_enabled": true
}
